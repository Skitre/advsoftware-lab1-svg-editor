{
  "name": "advsoftware-lab1-svg-editor",
  "version": "0.2.0",
  "private": true,
  "description": "Plugin-based SVG CLI editor for Advanced Software Lab 1 Phase 2",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "cli": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test 'test/**/*.test.ts' 'packages/*/test/**/*.test.ts' 'plugins/*/test/**/*.test.ts'",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@svgframe/kernel": "0.2.0",
    "@svgframe/plugin-builtin-commands": "0.2.0",
    "@svgframe/plugin-builtin-shapes": "0.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "bin": {
    "svg-editor": "bin/svg-editor"
  }
}
